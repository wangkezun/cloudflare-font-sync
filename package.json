{
  "name": "sarasa-fonts-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run test && npm run typecheck && npm run dry-run",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "resolve": "node scripts/resolve-release.mjs build/release.json",
    "test": "node --test",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "wrangler": "4.127.1"
  }
}
